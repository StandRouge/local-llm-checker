<%- include('../components/head') %>
<%- include('../components/header') %>
<main id="main" class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/models">Katalog</a> <span aria-hidden="true">/</span> <span><%= model.name %></span>
  </nav>

  <section class="hero">
    <p class="eyebrow"><%= model.family %> · <%= model.parameterLabel %></p>
    <h1><%= model.name %></h1>
    <p class="lead"><%= model.summary %></p>
    <ul class="badges">
      <% model.capabilities.forEach(function (capability) { %>
      <li class="badge"><%= capabilityLabels[capability] %></li>
      <% }) %>
    </ul>
  </section>

  <section class="panel" aria-label="Ringkasan model">
    <dl class="facts facts-wide">
      <div><dt>Ukuran unduhan</dt><dd><%= model.sizeGb %> GB</dd></div>
      <div><dt>Konteks</dt><dd><%= model.contextK %>K token</dd></div>
      <div><dt>Input</dt><dd><%= model.inputs.map(function (value) { return inputLabels[value]; }).join(', ') %></dd></div>
      <div><dt>Arsitektur</dt><dd><%= model.moe ? 'MoE (sparse)' : 'Dense' %></dd></div>
      <div><dt>Lisensi</dt><dd><%= model.license === null ? 'Lihat halaman resmi model' : model.license %></dd></div>
      <div><dt>Tag Ollama</dt><dd><code><%= model.ollamaTag %></code></dd></div>
    </dl>
  </section>

  <% if (fit !== null) { %>
  <%- include('../components/fit-banner') %>
  <% } else { %>
  <p class="muted"><a href="/">Cek perangkat Anda</a> untuk melihat apakah model ini cocok.</p>
  <% } %>

  <% if (mobileNotice) { %>
  <p class="notice">Menjalankan model lewat Ollama membutuhkan komputer Windows, macOS, atau Linux. Panduan di bawah berlaku untuk komputer tersebut.</p>
  <% } %>

  <nav class="tabs" aria-label="Pilih sistem operasi panduan">
    <% tabs.forEach(function (tab) { %>
    <a class="tab<%= tab.active ? ' is-active' : '' %>" href="<%= tab.href %>"<% if (tab.active) { %> aria-current="page"<% } %>><%= tab.label %></a>
    <% }) %>
  </nav>

  <%- include('../components/install-steps') %>

  <p class="muted">Sumber data model: <a href="<%= model.sourceUrl %>" rel="noopener noreferrer">halaman resmi di pustaka Ollama</a>.</p>
</main>
<%- include('../components/footer') %>
