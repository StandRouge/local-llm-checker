<%- include('../components/head') %>
<%- include('../components/header') %>
<main id="main" class="container">
  <section class="hero">
    <p class="eyebrow">Katalog</p>
    <h1>Model AI lokal terkini</h1>
    <p class="lead">Diurutkan dari yang paling ringan. Ukuran diverifikasi dari pustaka Ollama pada <%= meta.verifiedAt %>.</p>
  </section>
  <section class="grid" aria-label="Daftar model">
    <% models.forEach(function (model) { %>
    <%- include('../components/model-card', { model: model }) %>
    <% }) %>
  </section>
</main>
<%- include('../components/footer') %>
