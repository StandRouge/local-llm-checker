<article class="card model-card">
  <header>
    <h3><a href="/models/<%= model.slug %>"><%= model.name %></a></h3>
    <p class="family"><%= model.family %> · <%= model.parameterLabel %></p>
  </header>
  <p><%= model.summary %></p>
  <ul class="badges">
    <% model.capabilities.forEach(function (capability) { %>
    <li class="badge"><%= capabilityLabels[capability] %></li>
    <% }) %>
  </ul>
  <dl class="facts">
    <div><dt>Unduhan</dt><dd><%= model.sizeGb %> GB</dd></div>
    <div><dt>Konteks</dt><dd><%= model.contextK %>K</dd></div>
  </dl>
  <a class="button button-ghost" href="/models/<%= model.slug %>">Lihat detail dan instalasi</a>
</article>
